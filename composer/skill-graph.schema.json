{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillforge.invalid/schemas/skill-graph-1.0.0.json",
  "title": "SkillForge Skill Graph",
  "description": "Deterministic composed skill graph for one composition run or fixture.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "categoryKey", "graphHash", "nodes", "edges"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0.0" },
    "fixtureId": { "type": "string", "minLength": 1 },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "categoryKey": { "type": "string", "minLength": 1 },
    "brief": { "type": "string", "minLength": 1 },
    "graphHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeKey",
        "skillVersion",
        "name",
        "role",
        "tier",
        "priority",
        "assignedScope",
        "rationale"
      ],
      "properties": {
        "nodeKey": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "skillVersion": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "tier": { "type": "integer", "minimum": 1, "maximum": 7 },
        "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
        "assignedScope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": [
            "depends_on",
            "collaborates_with",
            "supersedes_scope",
            "conflicts_with",
            "reviews"
          ]
        }
      }
    }
  }
}
